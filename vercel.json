{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "outputDirectory": "dist/public",
    "functions": {
        "api/index.ts": {
            "includeFiles": "server/**,shared/**"
        }
    }
}